{% extends "_layouts/generic-page-layout.twig" %}


{% block content %}
{% set entry = craft.entries()
.uid(entryUid)
.one() %}

<main>
  <section class="container d-flex flex-column">
    <div class="row align-items-center justify-content-center ">
      <div class="col-lg-6 col-md-8  py-xl-0">
        <!-- Card -->
        <div class="crd sha dow">
          <!-- Card body -->
          <div class="card-body p-6 d-flex flex-column justify-content-center">
            <div class="flex-column justify-content-center">
              <div class="d-flex flex-column align-items-center mb-3">
                <div class="p-2">
                  <h1 class="mb-0 fw-bold">Thank you!</h1>
                </div>


          
                <div class="p-2 text-center">
                  <h4 class="mb-4">We have received your message and will respond in the next working day</h4>
                  <p>Below is a copy of what you have sent:</p>
                </div>
                  <table class="table">
                    <thead>
                      <tr>
                        <th scope="col">#</th>
                        <th scope="col">Details</th>

                      </tr>
                    </thead>
                    <tbody>
                      <tr>
                        <th scope="row">Name</th>
                        <td>{{entry.title}}</td>

                      </tr>
                      <tr>
                        <th scope="row">Tel</th>
                        <td>{{entry.phoneNumber}}</td>

                      </tr>
                      <tr>
                        <th scope="row">Email</th>
                        <td>{{entry.email}}</td>
                      </tr>
                      <tr>
                        <th scope="row">Preferred contact method</th>
                        <td>{{entry.contactPreference}}</td>
                      </tr>
                      <tr>
                        <th scope="row">Enquiry message</th>
                        <td>{{entry.body}}</td>
                      </tr>

                    </tbody>
                  </table>

            
              </div>
            </div>
          


          </div>
        </div>
      </div>
    </div>
  </section>

</main>
{% endblock content %}