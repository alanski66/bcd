<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 15px;
            line-height: 1.6;
            color: #333;
            background-color: #f5f5f5;
            margin: 0;
            padding: 0;
        }
        .wrapper {
            max-width: 600px;
            margin: 30px auto;
            background: #ffffff;
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }
        .header {
            background-color: #2c6e8a;
            color: #ffffff;
            padding: 28px 32px;
        }
        .header h1 {
            margin: 0 0 6px;
            font-size: 22px;
        }
        .header p {
            margin: 0;
            opacity: 0.85;
            font-size: 14px;
        }
        .body {
            padding: 28px 32px;
        }
        .intro {
            margin-bottom: 24px;
        }
        .field {
            margin-bottom: 16px;
            padding: 12px 16px;
            background-color: #f9f9f9;
            border-left: 4px solid #2c6e8a;
            border-radius: 0 4px 4px 0;
        }
        .field-label {
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #888;
            margin-bottom: 4px;
        }
        .field-value {
            font-size: 15px;
            color: #222;
        }
        .message-box {
            margin-bottom: 16px;
            padding: 16px;
            background-color: #f0f6fa;
            border: 1px solid #d0e6f0;
            border-radius: 4px;
        }
        .message-box .field-label {
            margin-bottom: 8px;
        }
        .message-text {
            white-space: pre-wrap;
            color: #333;
        }
        .footer {
            padding: 20px 32px;
            background-color: #f5f5f5;
            border-top: 1px solid #e5e5e5;
            font-size: 12px;
            color: #999;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <div class="header">
            <h1>New Enquiry</h1>
            <p>Hi {{ therapistName }}, you have received a new enquiry via {{ siteName }}.</p>
        </div>

        <div class="body">
            <div class="intro">
                <p>Here are the full details of the enquiry. Please respond directly to the contact details provided below.</p>
            </div>

            <div class="field">
                <div class="field-label">Name</div>
                <div class="field-value">{{ enquirerName }}</div>
            </div>

            <div class="field">
                <div class="field-label">Email</div>
                <div class="field-value"><a href="mailto:{{ enquirerEmail }}">{{ enquirerEmail }}</a></div>
            </div>

            <div class="field">
                <div class="field-label">Phone</div>
                <div class="field-value">{{ enquirerPhone ?: 'Not provided' }}</div>
            </div>

            <div class="field">
                <div class="field-label">Preferred contact method</div>
                <div class="field-value">{{ contactPreference ?: 'No preference stated' }}</div>
            </div>

            <div class="message-box">
                <div class="field-label">Message</div>
                <div class="message-text">{{ message ?: 'No message provided.' }}</div>
            </div>
        </div>

        <div class="footer">
            This notification was sent automatically by {{ siteName }}. Please do not reply to this email.
        </div>
    </div>
</body>
</html>
