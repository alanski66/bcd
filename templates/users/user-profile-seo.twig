{% extends "_layouts/generic-page-layout.twig" %}
{% block content %}

{% set user = user ?? currentUser %}
{% requireLogin %}

{% set successMessage = craft.app.session.getFlash('notice') %}
{% set errorMessage   = craft.app.session.getFlash('error') %}
{% set success        = craft.app.request.getParam('status') %}

{% macro errorList(errors) %}
  {% if errors %}{{ ul(errors, {class: 'errors'}) }}{% endif %}
{% endmacro %}

{# Determine which image will be used for social sharing #}
{% if user.ogImage|length %}
  {% set previewImage    = user.ogImage.one().url %}
  {% set previewImageSrc = 'Custom SEO image' %}
{% elseif user.photo|length %}
  {% set previewImage    = user.photo.url('profileMedium') %}
  {% set previewImageSrc = 'Profile photo (fallback)' %}
{% else %}
  {% set previewImage    = null %}
  {% set previewImageSrc = 'Site default (no image uploaded)' %}
{% endif %}

<main>
  <section class="pt-5 pb-5">
    <div class="container">

      <div class="row align-items-center">
        <div class="col-xl-12 col-lg-12 col-md-12 col-12">
          <div class="rounded-top"
            style="background: url(../assets/images/background/profile-bg.jpg) no-repeat; background-size: cover; height: 100px">
          </div>
          <div class="card px-4 pt-2 pb-4 shadow-sm rounded-top-0 rounded-bottom-0 rounded-bottom-md-2">
            <div class="d-flex align-items-end justify-content-between">
              <div class="d-flex align-items-center">
                <div class="me-2 position-relative d-flex justify-content-end align-items-end mt-n5">
                  {% if user.photo is not empty %}
                    <img src="{{ user.photo.url('profileSmall') }}"
                      class="avatar-xl rounded-circle border border-4 border-white"
                      alt="avatar">
                  {% endif %}
                </div>
                <div class="lh-1">
                  <h2 class="mb-0">{{ user.fullName }}</h2>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="row mt-0 mt-md-4">
        {% include "users/partials/user-sidenav.twig" %}

        <div class="col-lg-9 col-md-8 col-12">
          <div class="card">
            <div class="card-header">
              <h3 class="mb-0">SEO &amp; search settings</h3>
              <p class="mb-0">These settings control how your profile appears in search engines and when shared on social media. All fields are optional — sensible defaults are used automatically if left blank.</p>

              {% if success %}
                <div class="alert alert-success my-2" data-timeout="4000" role="alert">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                    fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                  </svg>
                  Your SEO settings have been saved successfully!
                </div>
              {% endif %}
            </div>

            <div class="card-body">
              <form id="seo-form" method="post" accept-charset="UTF-8"
                enctype="multipart/form-data">

                {{ csrfInput() }}
                {{ actionInput('users/save-user') }}
                {{ hiddenInput('userId', user.id) }}
                {{ redirectInput('/users/user-profile-seo?status=1') }}

                {# ── Previews ──────────────────────────────────── #}
                <div class="card mb-4 p-3">

                  <h4 class="mb-1">Search engine preview</h4>
                  <p class="text-muted small mb-3">
                    How your profile may appear in Google search results.
                  </p>

                  <div id="seo-preview" class="p-3 bg-light rounded-3 mb-4">
                    <div id="preview-title"
                      class="text-primary fw-medium mb-1"
                      style="font-size: 1.1rem;">
                      {{ user.seoTitle ?? user.fullName ~ ' — ' ~ user.titleRole }} | Brighton Counselling Directory
                    </div>
                    <div class="text-success small mb-1">
                      {{ alias('@baseUrl') }}/counsellors/{{ user.username|kebab }}/{{ user.id }}
                    </div>
                    <div id="preview-description" class="text-muted small">
                      {{ user.seoDescription ?? user.shortSummary }}
                    </div>
                  </div>

                  <h4 class="mb-1">Social media sharing preview</h4>
                  <p class="text-muted small mb-3">
                    How your profile will appear when shared on Facebook, LinkedIn and other platforms.
                    <span class="badge bg-secondary ms-1" style="font-size:0.7rem;">
                      Using: {{ previewImageSrc }}
                    </span>
                  </p>

                  <div class="border rounded-3 overflow-hidden" style="max-width: 500px;">

                    <div style="background: #e9ecef; aspect-ratio: 1.91/1; overflow: hidden; position: relative;">
                      {% if previewImage %}
                        <img id="og-preview-img"
                          src="{{ previewImage }}"
                          alt="Social share preview"
                          style="width: 100%; height: 100%; object-fit: cover;">
                      {% else %}
                        <div id="og-preview-img"
                          class="d-flex align-items-center justify-content-center h-100 text-muted"
                          style="font-size: 0.85rem;">
                          No image — site default will be used
                        </div>
                      {% endif %}
                      <div style="position: absolute; bottom: 8px; right: 8px;">
                        <span id="og-preview-badge"
                          class="badge bg-dark bg-opacity-75"
                          style="font-size: 0.65rem;">
                          {{ previewImageSrc }}
                        </span>
                      </div>
                    </div>

                    <div class="p-3 border-top bg-white">
                      <div class="text-muted text-uppercase mb-1"
                        style="font-size: 0.65rem; letter-spacing: 0.05em;">
                        brightoncounsellingdirectory.co.uk
                      </div>
                      <div id="og-preview-title"
                        class="fw-semibold mb-1"
                        style="font-size: 0.9rem; line-height: 1.3;">
                        {{ user.seoTitle ?? user.fullName ~ ' — ' ~ user.titleRole }}
                      </div>
                      <div id="og-preview-desc"
                        class="text-muted"
                        style="font-size: 0.8rem; line-height: 1.4;
                          display: -webkit-box; -webkit-line-clamp: 2;
                          -webkit-box-orient: vertical; overflow: hidden;">
                        {{ user.seoDescription ?? user.shortSummary }}
                      </div>
                    </div>

                  </div>

                  {% if user.ogImage|length %}
                    <p class="text-muted small mt-2 mb-0">
                      To revert to your profile photo, upload a replacement SEO image below.
                    </p>
                  {% elseif not user.photo|length %}
                    <p class="text-warning small mt-2 mb-0">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                        fill="currentColor" class="me-1" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091
                          1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535
                          0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0
                          0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                      </svg>
                      No profile photo uploaded — the site default image will be used when sharing.
                      Add a profile photo or upload a custom SEO image below.
                    </p>
                  {% endif %}

                </div>

                <hr class="my-4">

                {# SEO Title #}
                <div class="mb-4">
                  <label class="form-label fw-medium" for="seoTitle">
                    Page title
                    <span class="text-muted fw-normal" style="font-size:0.8rem;">— max 60 characters</span>
                  </label>
                  <input type="text"
                    id="seoTitle"
                    name="fields[seoTitle]"
                    class="form-control"
                    maxlength="60"
                    value="{{ user.seoTitle }}"
                    placeholder="{{ user.fullName }} — {{ user.titleRole }}">
                  <div class="d-flex justify-content-between">
                    <div class="form-text">
                      Auto-generated: <em>{{ user.fullName }} — {{ user.titleRole }}</em> —
                      "| Brighton Counselling Directory" is added automatically, don't include it here.
                    </div>
                    <div id="seoTitle-counter" class="form-text text-end"></div>
                  </div>
                </div>

                {# SEO Description #}
                <div class="mb-4">
                  <label class="form-label fw-medium" for="seoDescription">
                    Meta description
                    <span class="text-muted fw-normal" style="font-size:0.8rem;">— max 160 characters</span>
                  </label>
                  <textarea
                    id="seoDescription"
                    name="fields[seoDescription]"
                    class="form-control"
                    rows="3"
                    maxlength="160"
                    placeholder="{{ user.shortSummary }}">{{ user.seoDescription }}</textarea>
                  <div class="d-flex justify-content-between">
                    <div class="form-text">
                      Auto-generated from your short summary if left blank.
                    </div>
                    <div id="seoDescription-counter" class="form-text text-end"></div>
                  </div>
                </div>

                {# SEO Keywords #}
                <div class="mb-4">
                  <label class="form-label fw-medium" for="seoKeywords">Keywords</label>
                  <input type="text"
                    id="seoKeywords"
                    name="fields[seoKeywords]"
                    class="form-control"
                    value="{{ user.seoKeywords }}"
                    placeholder="e.g. anxiety therapist Brighton, CBT counsellor Hove">
                  <div class="form-text">
                    Comma separated. Focus on what clients would search for —
                    your therapy type, location and specialisms.
                  </div>
                </div>

                <hr class="my-4">

                {# SEO Image #}
                <div class="mb-4">
                  <label class="form-label fw-medium" for="ogImage">
                    SEO image
                    <span class="text-muted fw-normal" style="font-size:0.8rem;">
                      — recommended 1200×630px
                    </span>
                  </label>

                  {% if user.ogImage|length %}
                    {% set existingOg = user.ogImage.one() %}
                    <div class="mb-2">
                      <img src="{{ existingOg.url }}"
                        class="img-fluid rounded-3 mb-1"
                        style="max-height: 120px; width: auto;"
                        alt="Current SEO image">
                      <div class="form-text">Current SEO image</div>
                    </div>
                  {% endif %}

                  <input type="file"
                    id="ogImage"
                    name="fields[ogImage][]"
                    class="form-control"
                    accept="image/png,image/jpeg">

                  <div class="form-text">
                    This image appears in Google and when your profile is shared on Facebook,
                    LinkedIn and other platforms. Upload a landscape image at 1200×630px for
                    best results. If left blank your profile photo is used, though it may be cropped.
                  </div>
                </div>

                <hr class="my-4">

                {# FAQ section #}
                <h4 class="mb-1">Frequently asked questions</h4>
                <p class="text-muted mb-4">
                  Add questions and answers that potential clients commonly ask. These are
                  displayed on your profile and help search engines understand what you offer.
                  Many questions are generated automatically from your profile — add any extras here.
                </p>

                {% set existingFaqs = user.faqs ? user.faqs.all() : [] %}

                <div id="faqs-wrapper">
                  {% for entry in existingFaqs %}
                    <div class="faq-row card rounded-3 p-3 mb-3"
                      data-index="{{ loop.index0 }}">

                      <input type="hidden"
                        name="fields[faqs][{{ loop.index0 }}][entryId]"
                        value="{{ entry.id }}">
                      <input type="hidden"
                        name="fields[faqs][{{ loop.index0 }}][type]"
                        value="faq">

                      <div class="mb-2">
                        <label class="form-label fw-medium">Question</label>
                        <input type="text"
                          name="fields[faqs][{{ loop.index0 }}][fields][question]"
                          class="form-control"
                          value="{{ entry.question }}"
                          placeholder="e.g. Do you offer online therapy?">
                      </div>

                      <div class="mb-2">
                        <label class="form-label fw-medium">Answer</label>
                        <textarea
                          name="fields[faqs][{{ loop.index0 }}][fields][answer]"
                          class="form-control"
                          rows="3"
                          placeholder="e.g. Yes, I offer online sessions via Zoom...">{{ entry.answer }}</textarea>
                      </div>

                      <div class="text-end">
                        <button type="button"
                          class="btn btn-sm btn-outline-danger remove-faq">
                          Remove
                        </button>
                      </div>
                    </div>
                  {% endfor %}
                </div>

                <div style="min-height: 1.25rem;">
                  <span id="faq-error" class="text-danger small"></span>
                </div>

                <button type="button" id="add-faq"
                  class="btn btn-sm btn-outline-secondary mb-5">
                  + Add question
                </button>

                {% if errorMessage %}
                  <div class="alert alert-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                      fill="currentColor" class="bi bi-exclamation-triangle-fill me-2"
                      viewBox="0 0 16 16">
                      <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091
                        1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535
                        0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0
                        0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                    {{ errorMessage }}
                  </div>
                {% endif %}

                <div class="col-12 text-center">
                  <button class="btn btn-primary" type="submit">
                    Save SEO settings
                  </button>
                </div>

              </form>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>
</main>

{% js %}

// Character counters
['seoTitle', 'seoDescription'].forEach(function (id) {
  const input   = document.getElementById(id);
  const counter = document.getElementById(id + '-counter');
  if (!input || !counter) return;

  const max = parseInt(input.getAttribute('maxlength'));

  function update() {
    const remaining = max - input.value.length;
    counter.textContent = remaining + ' characters remaining';
    counter.style.color = remaining < 20 ? '#dc2626' : '#6b7280';
  }

  input.addEventListener('input', update);
  update();
});

// Live previews — search engine + social card
const titleInput   = document.getElementById('seoTitle');
const descInput    = document.getElementById('seoDescription');
const previewTitle = document.getElementById('preview-title');
const previewDesc  = document.getElementById('preview-description');
const ogTitle      = document.getElementById('og-preview-title');
const ogDesc       = document.getElementById('og-preview-desc');

const defaultTitle = '{{ user.fullName }} — {{ user.titleRole }}';
const defaultDesc  = '{{ (user.seoDescription ?? user.shortSummary)|striptags|replace({"'": "\\'", "\n": " ", "\r": ""}) }}';

if (titleInput) {
  titleInput.addEventListener('input', function () {
    const val = this.value || defaultTitle;
    // SEOmatic appends " | Brighton Counselling Directory" to <title> automatically
    // (Site Name Position: after) but not to og:title, so mirror that here.
    if (previewTitle) previewTitle.textContent = val + ' | Brighton Counselling Directory';
    if (ogTitle)      ogTitle.textContent      = val;
  });
}

if (descInput) {
  descInput.addEventListener('input', function () {
    const val = this.value || defaultDesc;
    if (previewDesc) previewDesc.textContent = val;
    if (ogDesc)      ogDesc.textContent      = val;
  });
}

// Live OG image preview when a new file is selected
const ogImageInput = document.getElementById('ogImage');
const ogBadge      = document.getElementById('og-preview-badge');

if (ogImageInput) {
  ogImageInput.addEventListener('change', function () {
    const file = this.files[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = function (e) {
      let imgEl = document.getElementById('og-preview-img');

      // If placeholder div exists replace it with an img element
      if (imgEl && imgEl.tagName !== 'IMG') {
        const newImg     = document.createElement('img');
        newImg.id        = 'og-preview-img';
        newImg.alt       = 'Social share preview';
        newImg.style.cssText = 'width: 100%; height: 100%; object-fit: cover;';
        imgEl.parentNode.replaceChild(newImg, imgEl);
        imgEl = newImg;
      }

      if (imgEl) imgEl.src = e.target.result;
      if (ogBadge) ogBadge.textContent = 'New image (unsaved)';
    };
    reader.readAsDataURL(file);
  });
}

// FAQ add/remove
(function () {
  const wrapper = document.getElementById('faqs-wrapper');
  const addBtn  = document.getElementById('add-faq');
  if (!wrapper || !addBtn) return;

  let index = wrapper.querySelectorAll('.faq-row').length;

  addBtn.addEventListener('click', function () {
    const row = document.createElement('div');
    row.className = 'faq-row card rounded-3 p-3 mb-3';
    row.dataset.index = index;

    row.innerHTML = `
      <input type="hidden" name="fields[faqs][${index}][entryId]" value="">
      <input type="hidden" name="fields[faqs][${index}][type]" value="faq">
      <div class="mb-2">
        <label class="form-label fw-medium">Question</label>
        <input type="text"
          name="fields[faqs][${index}][fields][question]"
          class="form-control"
          placeholder="e.g. Do you offer online therapy?">
      </div>
      <div class="mb-2">
        <label class="form-label fw-medium">Answer</label>
        <textarea
          name="fields[faqs][${index}][fields][answer]"
          class="form-control" rows="3"
          placeholder="e.g. Yes, I offer online sessions via Zoom..."></textarea>
      </div>
      <div class="text-end">
        <button type="button"
          class="btn btn-sm btn-outline-danger remove-faq">
          Remove
        </button>
      </div>`;

    addBtn.insertAdjacentElement('beforebegin', row);
    index++;
  });

  wrapper.addEventListener('click', function (e) {
    if (e.target.classList.contains('remove-faq')) {
      e.target.closest('.faq-row').remove();
    }
  });
})();

{% endjs %}

{% endblock %}