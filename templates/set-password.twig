
{% extends "_layouts/chromeless-page-layout.twig" %}


{% block content %}

<main>
  <section class="container d-flex flex-column vh-100">
      <div class="row align-items-center justify-content-center g-0 h-lg-100 py-8">
        <div class="col-lg-5 col-md-8 py-8 py-xl-0">
          <!-- Card -->
          <div class="card shadow">
            <!-- Card body -->
            <div class="card-body p-6 d-flex flex-column gap-4">
              <div>
                
                <a href="{{baseUrl}}">
                  <img src="../assets/images/brand/logo/logo.svg" class="mb-4" alt="logo" width="200px"></a>
                <div class="d-flex flex-column gap-1">
                  <h1 class="mb-0 fw-bold">Reset Password</h1>
                  
                </div>
              </div>
              <!-- Form -->
              
  

  <form method="post" accept-charset="UTF-8">
  {{ csrfInput() }}
  {{ actionInput('users/set-password') }}

  {# These two values are included in a password reset URL,
     and available in the template, automatically. They must
     be passed back when setting a new password to validate
     the request: #}
  {{ hiddenInput('code', code) }}
  {{ hiddenInput('id', id) }}
  {{ redirectInput('sign-in') }}

  <label for="new-password">New Password</label>
  {{ input('password', 'newPassword', null, {
    id: 'new-password',
     class: 'form-control mb-3',
  }) }}

  {% if errors is defined %}
    {{ ul(errors, { class: 'errors' }) }}
  {% endif %}

      <button class="btn btn-primary">Submit</button>

</form>
            </div>
          </div>
        </div>
      </div>
    </section>
    
  
</main>
{% endblock content %}