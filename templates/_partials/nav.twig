{% macro navActive(itemUri, currentPath) %}
  {% set itemUri = itemUri | trim('/') %}
  {% set currentPath = currentPath | trim('/') %}
  {% if itemUri == '__home__' or itemUri == '' %}
    {{ currentPath == '' ? 'active' : '' }}
  {% else %}
    {{ (currentPath == itemUri or currentPath starts with itemUri ~ '/') ? 'active' : '' }}
  {% endif %}
{% endmacro %}

{% from _self import navActive %}
{% set currentPath = craft.app.request.pathInfo %}

{% set hideTherapists = "" %}
{% if siteSettings.hideTherapists %} {% set hideTherapists = "d-none" %} {% endif %}
<nav class="navbar navbar-expand-lg sticky-top-mobile">
