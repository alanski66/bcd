      </ul>
    </div>

  </div>
</nav>

{% css %}
.navbar .nav-link.active {
  position: relative;
  border-bottom:1px solid #5e3fcb;
}
.navbar .nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0.5rem;
  right: 0.5rem;
  height: 2px;
  background-color: #5e3fcb;
  border-radius: 1px;
}
{% endcss %}

{% js %}
document.addEventListener('DOMContentLoaded', function () {
  const collapse    = document.getElementById('navbar-default');
  const burgerLines = document.getElementById('burger-lines');
  const crossLines  = document.getElementById('cross-lines');

  if (!collapse || !burgerLines || !crossLines) return;

  collapse.addEventListener('show.bs.collapse', function () {
    burgerLines.style.display = 'none';
    crossLines.style.display  = 'block';
  });

  collapse.addEventListener('hide.bs.collapse', function () {
    burgerLines.style.display = 'block';
    crossLines.style.display  = 'none';
  });
});
{% endjs %}