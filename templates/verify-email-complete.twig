{% extends "_layouts/chromeless-page-layout.twig" %}


{% block content %}

<main>
  <section class="container d-flex flex-column vh-100">
    <div class="row align-items-center justify-content-center g-0 h-lg-100 py-sm-8">
      <div class="col-lg-5 col-md-8 py-8 py-xl-0">
        <!-- Card -->
        <div class="card shadow">
          <!-- Card body -->
          <div class="card-body p-6 d-flex flex-column gap-4">
            

              <a href="{{baseUrl}}">
                <img src="../assets/images/brand/logo/logo.svg" class="mb-4" alt="logo" width="200px"></a>
              <div class="d-flex flex-column gap-1">
                <h2 class="mb-0 fw-bold">You have been verified and now may now sign in</h2>
                <p>If this is your first time signing in you will be taken to the 'complete your profile page'</p>
              </div>
            
            <!-- Form -->
            <form method="post" accept-charset="UTF-8" class="needs-validation" novalidate="">
              {{ csrfInput() }}
              {{ actionInput('users/login') }}
                  {{ redirectInput('users/user-profile-edit') }}
              <!-- Username -->
              <h2 class="text-primary">Sign in</h2>
              <div class="mb-3">

                <label for="loginName" class="form-label">Username or email</label>
                {{ input('text', 'loginName', craft.app.user.rememberedUsername, {
                id: 'loginName',
                class: 'form-control',
                autocomplete: 'username',
                required: ''
                }) }}
                <div class="invalid-feedback">Please enter valid username.</div>
              </div>
              <!-- Email -->

              <!-- Password -->
              <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                {{ input('password', 'password', null, {
                id: 'password',
                class: 'form-control',
                required: ''
                }) }}
                <div class="invalid-feedback">Please enter valid password.</div>
              </div>
              <!-- rememebr me -->
              {# <div class="mb-3">
                <label>
                  {{ input('checkbox', 'rememberMe', '1', {
                  class: 'form-check-input',
                  }) }}
                  Remember me
                </label>
              </div> #}
              <!-- Checkbox -->
              <div class="d-lg-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                  <input type="checkbox" class="form-check-input" id="rememberMe" value="1" required="">
                  <label class="form-check-label" for="rememberMe">Remember me</label>
                  <div class="invalid-feedback">You must agree before submitting.</div>
                </div>
                <div>
                  <a href="{{ url('reset-password') }}">Forgot your password?</a>
                </div>
              </div>
              <div>
                <!-- Button -->
                <div class="d-grid">
                  <button type="submit" class="btn btn-primary">Sign in</button>
                </div>
              </div>
              {% if errorMessage is defined %}
              <p class="errors">{{ errorMessage }}</p>
              {% endif %}
              <hr class="my-4">

            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>
</main>
{% endblock content %}