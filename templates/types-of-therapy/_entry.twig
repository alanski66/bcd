{% extends "_layouts/generic-page-layout.twig" %}


{% block content %}

{# ── Therapists offering this type of therapy ── #}
{% set matchedTherapists = craft.users()
  .group('counsellors')
  .hasPhoto()
  .profileComplete(true)
  .relatedTo({
    targetElement: entry,
    field: 'typesOfTherapyOfferred'
  })
  .orderBy('RAND()')
  .limit(6)
  .all() %}

{% set isFallback = matchedTherapists | length == 0 %}

{% if isFallback %}
  {% set matchedTherapists = craft.users()
    .group('counsellors')
    .hasPhoto()
    .profileComplete(true)
    .orderBy('RAND()')
    .limit(6)
    .all() %}
{% endif %}

<section class="pt-8 bg-light">
  <div class="container my-lg-8">
    <div class="row">
      <div class="offset-md-2 col-md-8 col-12">
        <div class="mb-8">
          <h1 class="display-4 fw-semibold mb-8">{{entry.title}}</h1>

          {{entry.body}}
        </div>


      </div>

    </div>
  </div>
</section>

{% if matchedTherapists | length %}
<section class="py-6 py-lg-8 bg-white">
  <div class="container">
    <div class="row mb-5">
      <div class="col-12 text-center">
        {% if isFallback %}
          <h2 class="h1 mb-2">Therapists in Brighton &amp; Hove</h2>
          <p class="text-muted">Browse our verified therapists — many work across a range of approaches and may be able to help.</p>
        {% else %}
          <h2 class="h1 mb-2">Therapists offering {{ entry.title | lower }}</h2>
          <p class="text-muted">All therapists listed are verified and based in Brighton &amp; Hove.</p>
        {% endif %}
      </div>
    </div>
    <div class="row g-4">
      {% for user in matchedTherapists %}
        {% include 'components/users/user-card-horizontal' %}
      {% endfor %}
    </div>
    <div class="row mt-5">
      <div class="col-12 text-center">
        <a href="{{ alias('@baseUrl') }}/find-a-therapist" class="btn btn-primary btn-lg">
          View all therapists
        </a>
      </div>
    </div>
  </div>
</section>
{% endif %}

<section class="d-none">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <hr>
      </div>
      <div class="col-xl-10 col-md-10 col-12 mx-auto">
        <div class="d-flex flex-column gap-2 text-center mb-xl-7 mb-5">
          <h2 class="h1 mb-0">Counsellors who offer this type of therapy</h2>
          <p class="mb-0 px-xl-5">  </p>
        </div>
        {% include 'components/users/user-slider-who-offer' %}
        
      </div>
    </div>
  </div>
</section>
<!-- category other issues -->
<!-- category issues list-->
<section class="py-xl-8 py-6">
  <div class="container">
    <div class="row">
      <div class="col-xl-10 col-md-10 col-12 mx-auto">
        <div class="d-flex flex-column gap-2 text-center mb-xl-7 mb-5">
          <h2 class="h1 mb-0">Get help with</h2>
          <p class="mb-0 px-xl-5">Discover valuable information on common mental health issues, and how counseling can
            help.</p>
        </div>
      </div>
    </div>
    <div class="row gy-4">
      {% set myCategoryQuery = craft.categories()
      .group('issues') %}
      {# Fetch the categories #}
      {% set categories = myCategoryQuery.all() %}
      {% for category in categories %}
      {% set numofEntries = craft.entries.section('issues').limit(null).relatedTo(category).count() %}
      <div class="col-xl-3 col-lg-4 col-md-6 col-12">
        <a href="{{category.url}}">
          <div class="card-hover-svg card card-body d-flex flex-column gap-4">

            <div>
              <h3 class="mb-0">{{ category.title }}</h3>
              <span class="text-gray-500">
                
              </span>
            </div>
          </div>
        </a>
      </div>

      {% endfor %}

      
    </div>
  </div>
</section>
{% endblock %}